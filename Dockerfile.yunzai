# Yunzai is an edition layered on a regular ALemonX image.  It deliberately
# consumes only the checked local .resources archives: this Dockerfile never
# clones a Yunzai repository and never bakes node_modules into the image.
ARG BASE_IMAGE=alemonx:local
FROM ${BASE_IMAGE}

USER root

# The Debian-based Node runtime used by the ALemonX base image already includes
# unzip. Do not run APT here: this layer only unpacks local resources, and an
# unnecessary package upgrade would make publishing depend on Debian mirrors.
RUN command -v unzip >/dev/null

COPY .resources/Miao-Yunzai-master.zip /tmp/yunzai/Miao-Yunzai-master.zip
COPY .resources/miao-plugin-master.zip /tmp/yunzai/miao-plugin-master.zip
COPY .resources/alemonjs-load-yunzai.tar.gz /tmp/yunzai/alemonjs-load-yunzai.tar.gz
COPY .resources/yunzai-resources.sha256 /tmp/yunzai/yunzai-resources.sha256
COPY resources/templates/bot/ /tmp/yunzai/bot-template/
COPY scripts/docker-yunzai-entrypoint.sh /usr/local/bin/alx-yunzai-entrypoint

RUN set -eu; \
  cd /tmp/yunzai; \
  sha256sum -c yunzai-resources.sha256; \
  seed=/opt/alx-yunzai-seed/bots/alemonb; \
  mkdir -p "${seed}/packages/alemonjs-load-yunzai"; \
  cp -a bot-template/. "${seed}/"; \
  tar -xzf alemonjs-load-yunzai.tar.gz -C "${seed}/packages/alemonjs-load-yunzai"; \
  unzip -q Miao-Yunzai-master.zip -d /tmp/yunzai/extract; \
  mv /tmp/yunzai/extract/Miao-Yunzai-master "${seed}/Miao-Yunzai"; \
  mkdir -p "${seed}/Miao-Yunzai/plugins"; \
  rm -rf /tmp/yunzai/extract; \
  unzip -q miao-plugin-master.zip -d /tmp/yunzai/extract; \
  mv /tmp/yunzai/extract/miao-plugin-master "${seed}/Miao-Yunzai/plugins/miao-plugin"; \
  printf '%s\\n' \
    'apps:' \
    '  - alemonjs-load-yunzai' \
    'redis:' \
    '  host: redis' \
    '  port: 6379' \
    '  db: 0' \
    'alemonjs-load-yunzai:' \
    '  bot_name: Miao-Yunzai' \
    > "${seed}/alemon.config.yaml"; \
  chmod 0755 /usr/local/bin/alx-yunzai-entrypoint; \
  rm -rf /tmp/yunzai

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/alx-yunzai-entrypoint"]
CMD ["--host", "0.0.0.0", "--port", "17390", "--redis-off"]
