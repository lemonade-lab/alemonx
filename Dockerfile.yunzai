# ALemonX image pre-seeded with the Yunzai robot stack. The seed is copied into
# the persistent workspace on first container start; writing it directly to
# /app/workspace here would be hidden by Docker Compose's workspace bind mount.
ARG ALX_YUNZAI_BASE=ccr.ccs.tencentyun.com/ningmengchongshui/alemonx:latest
FROM ${ALX_YUNZAI_BASE}

USER root

ARG TARGETARCH
# Pin formal ALX plugin releases so the Docker build remains reproducible. The
# installation itself still goes through `alx plugin install`, which validates
# the marketplace source, compatible release asset, checksum and manifest.
ARG ALX_QQ_VERSION=v0.1.12
ARG ALX_FINDER_VERSION=v0.0.3

RUN set -eux; \
    mkdir -p /opt/alx-yunzai-seed/bots/alemonb/packages; \
    case "$TARGETARCH" in amd64|arm64) ;; *) echo "不支持的 alemonx-qq 构建架构：$TARGETARCH" >&2; exit 1;; esac; \
    ALX_WORKSPACE=/opt/alx-yunzai-seed /app/alx plugin install alemonx-qq "$ALX_QQ_VERSION" "alemonx-qq-linux-$TARGETARCH.zip"; \
    if [ "$TARGETARCH" = amd64 ]; then \
      ALX_WORKSPACE=/opt/alx-yunzai-seed /app/alx plugin install alemonx-finder "$ALX_FINDER_VERSION" "alemonx-finder-linux-amd64.zip"; \
    fi; \
    git clone --depth=1 --branch release https://github.com/yunzaijs/alemonjs-load-yunzai.git /opt/alx-yunzai-seed/bots/alemonb/packages/alemonjs-load-yunzai; \
    git clone --depth=1 https://github.com/TimeRainStarSky/Yunzai.git /opt/alx-yunzai-seed/bots/alemonb/Yunzai; \
    git clone --depth=1 https://github.com/yoimiya-kokomi/miao-plugin.git /opt/alx-yunzai-seed/bots/alemonb/Yunzai/plugins/miao-plugin; \
    git clone --depth=1 https://github.com/TimeRainStarSky/Yunzai-genshin.git /opt/alx-yunzai-seed/bots/alemonb/Yunzai/plugins/genshin; \
    git clone --depth=1 https://github.com/guoba-yunzai/guoba-plugin.git /opt/alx-yunzai-seed/bots/alemonb/Yunzai/plugins/Guoba-Plugin

# The bot template supplies package metadata and the AlemonJS runtime entry;
# the repositories above supply the Yunzai implementation and its plugins.
COPY resources/templates/bot/ /opt/alx-yunzai-seed/bots/alemonb/
COPY scripts/docker-yunzai-entrypoint.sh /usr/local/bin/alx-yunzai-entrypoint
RUN chmod 755 /usr/local/bin/alx-yunzai-entrypoint

ENV ALX_YUNZAI_SEED=/opt/alx-yunzai-seed
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/alx-yunzai-entrypoint", "/app/alx"]
CMD ["--host", "0.0.0.0", "--port", "17390"]
