# ALemonX runtime base. Rebuild and publish this image manually when Debian
# security updates or runtime system dependencies need to change.
FROM node:22.22.3

# Keep package indexes and downloaded archives in BuildKit's cache.  The helper
# refreshes indexes immediately before an install, so a rebuilt layer cannot use
# an index cached independently from its packages.  It also retries transient
# mirror/CDN errors such as HTTP 502 without masking a final failure.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    'attempt=1' \
    'while [ "$attempt" -le 4 ]; do' \
    '  if apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update; then' \
    '    if apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 install -y --no-install-recommends "$@"; then' \
    '      exit 0' \
    '    fi' \
    '  fi' \
    '  if [ "$attempt" -eq 4 ]; then' \
    '    exit 1' \
    '  fi' \
    '  sleep "$((attempt * 5))"' \
    '  attempt=$((attempt + 1))' \
    'done' \
    > /usr/local/bin/alx-apt-install \
    && chmod 0755 /usr/local/bin/alx-apt-install

# 第一组：保留原有基础工具
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install \
    ca-certificates curl git lsof openssh-client tini unzip \
    && echo "✅ 基础工具安装完成"

# 第二组：保留原有字体
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install \
    fonts-noto-cjk fonts-noto-color-emoji \
    && echo "✅ 字体安装完成"

# Python 环境安装（保留原有依赖）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install \
    python3 python3-pip python3-venv python3-dev \
    && echo "✅ Python installed"

# 创建 Python 软链接
RUN ln -sf /usr/bin/python3 /usr/bin/python \
    && echo "✅ Python symlink created"

# 创建虚拟环境并升级 pip（关键修改）
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && echo "Python 虚拟环境已就绪"

# 使用虚拟环境的 pip 安装 Python 包（关键修改）
RUN /opt/venv/bin/pip install --no-cache-dir \
    requests httpx aiohttp \
    aiofiles \
    python-dotenv pyyaml \
    click rich tqdm \
    jieba \
    langchain langchain-community langchain-openai langchain-anthropic \
    openai anthropic \
    sqlalchemy \
    websockets \
    pydantic pydantic-settings \
    loguru \
    pytest pytest-asyncio

# 第三组：Chromium（容易失败）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install chromium

# 第四组：保留原有 X11 依赖，并补齐 xkbcomp 与受控桌面入口。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install \
    xvfb x11-utils x11-xkb-utils xkb-data xauth procps x11vnc novnc websockify

# 第五组：保留原有 GUI 依赖库。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    alx-apt-install \
    libnss3 \
    libgbm1 \
    libglib2.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    libgtk-3-0 \
    libasound2 \
    libcups2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxkbcommon0

# 清理
RUN /opt/venv/bin/pip cache purge \
    && corepack enable

# 设置环境变量 - 优先使用虚拟环境
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV="/opt/venv"

# QQ 图形运行契约不完整时必须让镜像构建失败。
RUN set -eux; \
    command -v Xvfb; command -v xkbcomp; command -v x11vnc; command -v websockify; \
    test -d /usr/share/X11/xkb; \
    if ldd "$(command -v Xvfb)" | grep -q 'not found'; then echo "Xvfb 动态库不完整" >&2; exit 1; fi; \
    Xvfb :99 -screen 0 1280x720x24 -nolisten tcp -ac & xvfb_pid=$!; \
    trap 'kill "$xvfb_pid" 2>/dev/null || true' EXIT; \
    for i in $(seq 1 20); do test -S /tmp/.X11-unix/X99 && break; sleep 0.1; done; \
    test -S /tmp/.X11-unix/X99; \
    kill "$xvfb_pid"; wait "$xvfb_pid" || true; trap - EXIT; \
    python --version; pip --version

# 设置工作目录
WORKDIR /app
