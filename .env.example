# Docker image. Use alx:local after `make docker-build`.
ALX_IMAGE=ccr.ccs.tencentyun.com/ningmengchongshui/alemonx:latest

# Host port exposed by the workbench.
ALX_PORT=17390

# Container name shown by docker ps; customize for multi-instance deployments.
ALX_CONTAINER_NAME=alx

# Runtime data lives in two host directories next to docker-compose.yml:
#   ./data       -> container /data (accounts, config, SQLite, caches)
#   ./workspace  -> container /app/workspace (templates, bots, tools)
# The container runs as root, so host-mounted directories work out of the box
# without any chown/chmod on the host.

# Keep production enabled unless this is a disposable local development run.
ALX_DEPLOYMENT=production
TZ=Asia/Shanghai

# Storage retention valves (days). Chat defaults to 30, testone to 7; both
# clamp to 1-365 and expire automatically on startup and on writes.
# ALX_CHAT_RETENTION_DAYS=30
# ALX_TESTONE_RETENTION_DAYS=7
